    {
      "index": 40,
      "characters": 18,
      "text": "PICKING UP SNAKES."
    },
    {
      "index": 41,
      "characters": 0,
      "text": ""
    },
    {
      "index": 42,
      "characters": 50,
      "text": "In  the  right  part  of screen there is a pile of"
    },
    {
      "index": 43,
      "characters": 50,
      "text": "cassettes, each of them connects full  information"
    },
    {
      "index": 44,
      "characters": 27,
      "text": "about one particular snake."
    },
    {
      "index": 45,
      "characters": 0,
      "text": ""
    },
    {
      "index": 46,
      "characters": 50,
      "text": "In  the  four  upper  cells you put cassettes with"
    },
    {
      "index": 47,
      "characters": 50,
      "text": "snakes that you intend for next  round  of  battle"
    },
    {
      "index": 48,
      "characters": 50,
      "text": "(let's  call them \"battle-pile\"). The top cassette"
    },
    {
      "index": 49,
      "characters": 50,
      "text": "is  intended  also  for  work  (teaching,  editing"
    },
    {
      "index": 50,
      "characters": 26,
      "text": "passport, changing colour)"
    },
    {
      "index": 51,
      "characters": 0,
      "text": ""
    },
    {
      "index": 52,
      "characters": 50,
      "text": "In  the  lower  pile there is the bank of existing"
    },
    {
      "index": 53,
      "characters": 7,
      "text": "snakes."
    },
    {
      "index": 54,
      "characters": 8,
      "text": "%EndPage"
    },
    {
      "index": 55,
      "characters": 0,
      "text": ""
    },
    {
      "index": 56,
      "characters": 50,
      "text": "Place arrow pointer on the snake you want  to  put"
    },
    {
      "index": 57,
      "characters": 50,
      "text": "into  competition  and  press Enter or click mouse"
    },
    {
      "index": 58,
      "characters": 50,
      "text": "button. Then point a position in the \"battle-pile\""
    },
    {
      "index": 59,
      "characters": 50,
      "text": "and press Enter once more. If the cell was already"
    },
    {
      "index": 60,
      "characters": 50,
      "text": "filled, the previous  snake  will  return  to  the"
    },
    {
      "index": 61,
      "characters": 5,
      "text": "bank."
    },
    {
      "index": 62,
      "characters": 0,
      "text": ""
    },
    {
      "index": 63,
      "characters": 50,
      "text": "To  see  the  next part of the list choose the red"
    },
    {
      "index": 64,
      "characters": 6,
      "text": "arrow."
    },
    {
      "index": 65,
      "characters": 0,
      "text": ""
    },
    {
      "index": 66,
      "characters": 50,
      "text": "To begin creating a new snake choose the top  cell"
